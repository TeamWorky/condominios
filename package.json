{
  "name": "@teamworky/condominios",
  "version": "1.0.0",
  "description": "Nx monorepo - Sistema de Gestión de Condominios (Angular + NestJS)",
  "author": "TeamWorky",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build api && nest build worker",
    "build:api": "nest build api",
    "build:worker": "nest build worker",
    "build:web": "cd apps/web && npx ng build --configuration=production",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:dev": "node ./start-all.js",
    "start:api": "nest start api --watch",
    "start:api:prod": "node dist/apps/api/src/main",
    "start:worker": "nest start worker --watch",
    "start:worker:prod": "node dist/apps/worker/src/main",
    "start:web": "cd apps/web && npx ng serve",
    "start:mobile": "adb reverse tcp:8081 tcp:8081 2>/dev/null; adb reverse tcp:19000 tcp:19000 2>/dev/null; cd apps/mobile && npx expo start --android",
    "start:mobile:ios": "nx run-ios mobile",
    "start:mobile:android": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:19000 tcp:19000 && cd apps/mobile && npx expo start --android",
    "start:debug": "nest start api --debug --watch",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:html": "jest --coverage && (open coverage/index.html || xdg-open coverage/index.html || start coverage/index.html || echo 'Open coverage/index.html in your browser')",
    "test:cov:summary": "jest --coverage --coverageReporters=text-summary",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:web": "cd apps/web && npx ng test",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d libs/database/src/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d libs/database/src/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d libs/database/src/data-source.ts"
  },
  "dependencies": {
    "@angular/animations": "^21.0.6",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@expo/metro-config": "~54.0.9",
    "@expo/metro-runtime": "~6.1.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@scalar/nestjs-api-reference": "^1.0.9",
    "@types/nodemailer": "^7.0.4",
    "axios": "^1.7.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.65.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "expo": "~54.0.0",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.11",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "nest-winston": "^1.10.2",
    "nodemailer": "^7.0.11",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "~0.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0",
    "typeorm": "^0.3.28",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@expo/cli": "~54.0.16",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@nx/angular": "^22.5.4",
    "@nx/eslint": "^22.5.4",
    "@nx/expo": "^22.5.4",
    "@nx/jest": "^22.5.4",
    "@nx/js": "^22.5.4",
    "@nx/workspace": "^22.5.4",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.0",
    "@types/supertest": "^6.0.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jsdom": "^27.1.0",
    "json-server": "^1.0.0-beta.3",
    "metro-config": "~0.83.0",
    "metro-resolver": "~0.83.0",
    "nx": "^22.5.4",
    "prettier": "~3.6.2",
    "react-refresh": "^0.18.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.8"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps/api/",
      "<rootDir>/apps/worker/",
      "<rootDir>/libs/"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.base.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@condominios/common(.*)$": "<rootDir>/libs/common/src$1",
      "^@condominios/database(.*)$": "<rootDir>/libs/database/src$1",
      "^@condominios/infrastructure(.*)$": "<rootDir>/libs/infrastructure/src$1",
      "^@condominios/shared(.*)$": "<rootDir>/libs/shared/src$1"
    },
    "collectCoverageFrom": [
      "apps/**/*.(t|j)s",
      "libs/**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.interface.ts",
      "!**/*.dto.ts",
      "!**/*.entity.ts",
      "!**/*.enum.ts",
      "!**/main.ts",
      "!**/index.ts",
      "!**/*.module.ts",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      },
      "./apps/api/src/auth/auth.service.ts": {
        "branches": 80,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "testEnvironment": "node"
  }
}
